# Existing Gemini-powered Horizon AI agent
GEMINI_API_KEY=

# Optional storefront URL for the dashboard Live Preview.
# Or paste the URL printed by "shopify theme dev" into the Live Preview panel.
NEXT_PUBLIC_SHOPIFY_THEME_PREVIEW_URL=

# Shopify AI Toolkit + Shopify Dev MCP
# MCP tools are dynamically discovered and bridged into Gemini function calling.
# Keep disabled until Node.js 20+ and npx are available on the server.
SHOPIFY_DEV_MCP_ENABLED=false
SHOPIFY_DEV_MCP_PACKAGE=@shopify/dev-mcp@1.19.0
# Optional overrides:
# SHOPIFY_DEV_MCP_COMMAND=npx
# SHOPIFY_DEV_MCP_ARGS=["-y","@shopify/dev-mcp@1.19.0"]
# Minimum effective connection timeout is 60000ms to allow first-run npx startup.
SHOPIFY_DEV_MCP_CONNECT_TIMEOUT_MS=60000
SHOPIFY_DEV_MCP_TOOL_TIMEOUT_MS=20000
# Local stdio MCP is disabled on serverless hosts by default.
SHOPIFY_DEV_MCP_ALLOW_SERVERLESS=false

# Existing runtime test runner (only needed when using /api/test-runner)
TEST_RUNNER_SECRET=
GITHUB_TOKEN=
